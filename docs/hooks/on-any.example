#!/bin/sh
# Example ftask hook: a desktop notification when the human acts on a task (Linux notify-send, macOS osascript).
# NOT installed by default. To use it (Linux; on macOS use ~/Library/Application Support/ftask/hooks):
#   mkdir -p ~/.config/ftask/hooks
#   cp docs/hooks/on-any.example ~/.config/ftask/hooks/on-any && chmod +x ~/.config/ftask/hooks/on-any
#
# Called (asynchronously, 30 s limit) for every human event: done, cancelled, reopened, note, step, upload.
# stdin: the event as JSON. env: FTASK_ID FTASK_KEY FTASK_EVENT FTASK_PROJECT FTASK_TITLE FTASK_SEQ FTASK_DB.
# Specific hooks also exist: on-done, on-note, on-upload (on-any runs after them).

case "$FTASK_EVENT" in
  done)      verb="marked done" ;;
  cancelled) verb="cancelled" ;;
  reopened)  verb="reopened" ;;
  note)      verb="wrote a note on" ;;
  upload)    verb="uploaded a file to" ;;
  step)      verb="ticked a step on" ;;
  *)         verb="updated" ;;
esac

# Event JSON arrives on stdin; read it so the writer never sees a broken pipe.
payload=$(cat)
body="${FTASK_PROJECT}: ${FTASK_TITLE}"
if [ "$FTASK_EVENT" = "note" ]; then
  preview=$(printf '%s' "$payload" | python3 -c 'import json,sys; print(json.load(sys.stdin)["detail"].get("note","")[:200])' 2>/dev/null)
  [ -n "$preview" ] && body="$body
$preview"
fi

title="The human $verb a task"
if command -v notify-send >/dev/null 2>&1; then
  notify-send --app-name="ftask" "$title" "$body"
elif command -v osascript >/dev/null 2>&1; then
  # pass text as arguments so quotes in a title can never break out of the AppleScript
  osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$title" "$body"
fi
