#!/usr/bin/env python3
"""Development launcher: run ftask straight from a git checkout (the installed entry point is `ftask`)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from ftask.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
